# Copy this file to .env and fill in your own keys. Never commit .env.

# Writes the answers. Get a key at openrouter.ai (free models need no credit).
OPENROUTER_API_KEY=
# "openrouter/free" picks a currently available free model. Free models change often,
# so if you want one specific model, put its id here instead.
OPENROUTER_MODEL=openrouter/free

# Meaning-based search (embeddings). Get a key at aistudio.google.com. Optional:
# without it the search uses keywords only.
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001

# Optional tuning (see README, "Tuning refusals")
# KW_MIN=0.40
# SEM_MIN=0.55
# PORT=8000

# Max questions per minute per user on /api/ask (default 10)
# RATE_LIMIT_PER_MIN=10

# ---- AI gateway (all optional, these are the defaults) ----
# Models: small for simple lookups, large for multi-part questions, fallback if the first call fails.
# MODEL_SMALL=openrouter/free
# MODEL_LARGE=openrouter/free
# MODEL_FALLBACK=
# Token budget: per team per day, and the size cap of one request.
# DAILY_TOKEN_BUDGET=20000
# REQUEST_TOKEN_CAP=3000
# Semantic cache: how alike two questions must be (0 to 1) and how long an answer is kept.
# CACHE_SIMILARITY=0.92
# CACHE_TTL_HOURS=72
# Retrieval: "weighted" (default, tuned) or "rrf" (rank fusion).
# RETRIEVAL=weighted
# Batch jobs: workers, pause between AI calls, batches allowed per minute per user.
# JOB_WORKERS=1
# JOB_PACE_SECONDS=3.5
# JOB_LIMIT_PER_MIN=5
# Notional price per 1,000 tokens in INR, used for the cost tile (free models cost nothing).
# PRICE_SMALL_INR_PER_1K=0.05
# PRICE_LARGE_INR_PER_1K=0.30
